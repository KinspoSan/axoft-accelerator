# Сервер
PORT=3000
APP_URL=https://your-domain.ru

# База данных
DB_PATH=data/axoft.db

# JWT (сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_64_random_bytes

# Bitrix24 (не попадают в браузер — только сервер)
BITRIX_CRM_WEBHOOK=https://your-portal.bitrix24.ru/rest/1/your_token
BITRIX_LISTS_WEBHOOK=https://your-portal.bitrix24.ru/rest/1/your_token

# Bitrix24 Universal Lists IDs
LIST_ID_PACKAGES=123
LIST_ID_MATERIALS=125
LIST_ID_SERVICES=127
LIST_ID_SETTINGS=129
LIST_ID_PARTNER_PACKAGES=143

# Корпоративный SMTP
SMTP_HOST=smtp.your-domain.ru
SMTP_PORT=465
SMTP_USER=program@your-domain.ru
SMTP_PASS=your_password
SMTP_FROM=program@your-domain.ru

# DaData (опционально)
DADATA_TOKEN=
